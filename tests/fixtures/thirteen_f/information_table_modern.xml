<?xml version="1.0" encoding="UTF-8"?>
<!--
  A post-2023 information table: values in whole dollars, and a <figi> column
  that no filing before 2023 has.

  Three things about this document are deliberate and none of them is
  cosmetic:

  * The namespace URI is not one EDGAR serves, and it is carried on a prefix
    rather than as a default namespace. Both are here to fail the day someone
    replaces a local-name() lookup with a hardcoded URI or an unprefixed tag
    match — a change that passes every other fixture in this directory.
  * The same CUSIP appears on three rows: the common stock, a call and a put.
    That is legal, common, and the reason holding's natural key includes
    put_call.
  * Six rows are defective, each in one way, and each defect is one a filing
    agent has actually produced.
-->
<it:informationTable xmlns:it="http://www.sec.gov/edgar/document/thirteenf/informationtable/2023">

  <!-- Common stock, fully populated, with the filer's own FIGI. -->
  <it:infoTable>
    <it:nameOfIssuer>MICROSOFT CORP</it:nameOfIssuer>
    <it:titleOfClass>COM</it:titleOfClass>
    <it:cusip>594918104</it:cusip>
    <it:figi>BBG000BPH459</it:figi>
    <it:value>12345678900</it:value>
    <it:shrsOrPrnAmt>
      <it:sshPrnamt>29340000</it:sshPrnamt>
      <it:sshPrnamtType>SH</it:sshPrnamtType>
    </it:shrsOrPrnAmt>
    <it:investmentDiscretion>SOLE</it:investmentDiscretion>
    <it:otherManager>1</it:otherManager>
    <it:votingAuthority>
      <it:Sole>29340000</it:Sole>
      <it:Shared>0</it:Shared>
      <it:None>0</it:None>
    </it:votingAuthority>
  </it:infoTable>

