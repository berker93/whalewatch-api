# Copy to .env. Compose reads this file twice: once for ${...} substitution in
# docker-compose.yml, and again as env_file for the api container.
#
# Every variable the app reads is declared in app/core/config.py. Anything here
# without a match there (the host port mappings below) is compose-only and is
# ignored by Settings.

# --- host port mapping -------------------------------------------------------
# Container-internal ports never change (db:5432, redis:6379, api:8000). These
# only decide what gets published on localhost, and exist so this stack can run
# at the same time as other Docker projects.
#
# 5433, not 5432: predictor-api publishes its Postgres on host 5432. If that
# stack is stopped you can set this back to 5432.
DB_PORT=5433
REDIS_PORT=6379
API_PORT=8000

# --- SEC / EDGAR -------------------------------------------------------------
# REQUIRED, no default. The app refuses to start without it.
#
# SEC's fair-access policy requires a real, monitored contact address in the
# User-Agent of every EDGAR request; they throttle or block traffic that omits
# or fakes one. Shipping a placeholder default would mean discovering that as a
# 403 halfway through a backfill, so there is deliberately nothing to fall back
# on. Put your own address here.
SEC_CONTACT_EMAIL=

# Requests per second against EDGAR. SEC publishes a ceiling of 10; Settings
# rejects anything above it, so this can only be tuned downwards.
SEC_RATE_LIMIT_PER_SECOND=8.0

# Development only; refused in staging and production. When set, every EDGAR
# response body is kept under this directory and served from it next time, so
# iterating on a parser does not refetch the same submissions pages. Nothing
# expires: delete the directory to see what EDGAR says today.
# EDGAR_CACHE_DIR=.edgar-cache

# --- raw document archive ----------------------------------------------------
# Every EDGAR document ingest-filing fetches is kept here, byte for byte, before
# it is parsed, under raw/13f/{cik}/{accession_no}/{filename}. A parser fix is
# then a re-parse of these bytes rather than a re-crawl of EDGAR.
#
# local writes under RAW_STORE_LOCAL_ROOT (keys start raw/, so ./data/raw/) and
# is refused in staging and production, where a container's disk does not
# outlive the next deploy. s3 is any S3-compatible bucket.
RAW_STORE_BACKEND=local
# RAW_STORE_LOCAL_ROOT=data

# Required when RAW_STORE_BACKEND=s3. For Cloudflare R2, set the endpoint to
# https://<account-id>.r2.cloudflarestorage.com and the region to auto; for AWS,
# leave the endpoint unset. Leave both keys unset to use botocore's own
# credential chain (an instance role); set both or neither.
# RAW_STORE_S3_BUCKET=whalewatch-raw
# RAW_STORE_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# RAW_STORE_S3_REGION=auto
# RAW_STORE_S3_ACCESS_KEY_ID=
# RAW_STORE_S3_SECRET_ACCESS_KEY=

# --- Postgres ----------------------------------------------------------------
# Parts, not a pasted DATABASE_URL — Settings.database_url assembles the DSN and
# is the only thing that knows its shape. These same values configure the `db`
# container in docker-compose.yml, so the credentials the server is created with
# and the ones the app connects with cannot drift apart.
#
# POSTGRES_HOST is the compose service name, not localhost: it is resolved on
# the compose network, where the host port mappings above are irrelevant.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=whalewatch
POSTGRES_PASSWORD=localdev
POSTGRES_DB=whalewatch
# Created by scripts/init-db.sql so a test run truncating tables cannot touch
# the dev data.
POSTGRES_TEST_DB=whalewatch_test

# --- application -------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Service name. Shows up in the OpenAPI title and — the reason it is settable at
# all — in the User-Agent sent to EDGAR, as "<APP_NAME> <SEC_CONTACT_EMAIL>".
# Changing it changes what SEC sees us as.
APP_NAME=WhaleWatch

# Deliberately commented out. GIT_SHA is stamped into the *image* at build time
#   docker build --build-arg GIT_SHA=$(git rev-parse --short HEAD) .
# and echoed by /health, so "which commit is this container running?" is
# answerable without exec'ing in. Compose's env_file wins over the image's ENV,
# so uncommenting this would overwrite a real build stamp with whatever is
# written here. Unset it reports "unknown", which is the honest answer for a
# local uvicorn that has no build behind it.
# GIT_SHA=unknown

# One of: local, test, staging, production. Anything else fails validation.
# Also picks the log renderer: staging and production emit one JSON object per
# line for the aggregator, everything else a coloured console line for a human.
ENVIRONMENT=local

# DEBUG, INFO, WARNING, ERROR or CRITICAL. Applies to our own events and to
# uvicorn/SQLAlchemy alike, since both go through the same handler. Note that
# DEBUG lets SQLAlchemy log every statement it emits.
LOG_LEVEL=DEBUG
DEBUG=true
